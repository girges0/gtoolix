{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/qr-code-generator",
      "destination": "/qrcode/generator",
      "permanent": true
    },
    {
      "source": "/youtube-thumbnail-downloader",
      "destination": "/youtube/thumbnail-downloader",
      "permanent": true
    },
    {
      "source": "/gemini-watermark-remover",
      "destination": "/gemini/watermark-remover",
      "permanent": true
    },
    {
      "source": "/screen-recorder-studio",
      "destination": "/screen-recorder/studio",
      "permanent": true
    },
    {
      "source": "/tools/qr/:path*",
      "destination": "/qrcode/generator",
      "permanent": true
    },
    {
      "source": "/tools/thumbnail/:path*",
      "destination": "/youtube/thumbnail-downloader",
      "permanent": true
    },
    {
      "source": "/tools/gemini/:path*",
      "destination": "/gemini/watermark-remover",
      "permanent": true
    },
    {
      "source": "/tools/screen-recorder/:path*",
      "destination": "/screen-recorder/studio",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/monitoring/:path*",
      "destination": "/gtoolix-monitoring-site/:path*"
    },
    {
      "source": "/monitoring",
      "destination": "/gtoolix-monitoring-site/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(self), camera=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}